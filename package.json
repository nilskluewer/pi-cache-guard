{
  "name": "@nilskluewer/pi-cache-guard",
  "version": "0.6.1",
  "description": "Pi extension with a prompt-cache countdown and cost warnings. Dynamically adjusts cache estimates from API-reported hits and misses. With contributions from @paulrohde675.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "prompt-cache",
    "cache",
    "cost",
    "anthropic"
  ],
  "author": {
    "name": "Nils Klüwer",
    "url": "https://github.com/nilskluewer"
  },
  "contributors": [
    {
      "name": "paulrohde675",
      "url": "https://github.com/paulrohde675"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nilskluewer/pi-cache-guard.git"
  },
  "bugs": {
    "url": "https://github.com/nilskluewer/pi-cache-guard/issues"
  },
  "homepage": "https://github.com/nilskluewer/pi-cache-guard#readme",
  "files": [
    "extensions",
    "assets",
    "README.md",
    "PATCH_NOTES.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/cache-guard.ts"
    ],
    "image": "https://cdn.jsdelivr.net/npm/@nilskluewer/pi-cache-guard@0.6.1/assets/cache-guard-preview.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "@earendil-works/pi-coding-agent": ">=1.3.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "pack:dry": "npm pack --dry-run",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run smoke"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
