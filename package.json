{
  "name": "@nilskluewer/pi-cache-guard",
  "version": "0.3.1",
  "description": "Pi extension that shows a prompt-cache countdown and asks before a message re-writes an expired cache, with predicted cost and cheaper model options.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "prompt-cache",
    "cache",
    "cost",
    "anthropic"
  ],
  "author": {
    "name": "Nils Klüwer",
    "url": "https://github.com/nilskluewer"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nilskluewer/pi-cache-guard.git"
  },
  "bugs": {
    "url": "https://github.com/nilskluewer/pi-cache-guard/issues"
  },
  "homepage": "https://github.com/nilskluewer/pi-cache-guard#readme",
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/cache-guard.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=1.0.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "pack:dry": "npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
